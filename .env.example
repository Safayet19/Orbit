# Existing PostgreSQL database URL. Must target orbit_db.
DATABASE_URL=

# Admin access: username, Argon2id password hash, and a random 32+ byte secret.
# Generate a hash with: python -m backend.app.cli hash-password
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Comma-separated browser origins. Local development default: http://localhost:5173
ADMIN_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_COOKIE_SECURE=false
APP_ENV=development
